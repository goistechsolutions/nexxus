diff --git a/systemd/nexxus-api.service b/systemd/nexxus-api.service
--- a/systemd/nexxus-api.service
+++ b/systemd/nexxus-api.service
@@
 [Unit]
 Description=Nexxus FastAPI API
-After=network-online.target postgresql.service
+After=network-online.target
 Wants=network-online.target
-Requires=postgresql.service

 [Service]
 Type=exec
 User=nexxus
 Group=nexxus

 EnvironmentFile=/etc/nexxus/api.env

 WorkingDirectory=/opt/nexxus/current/backend

 ExecStartPre=/opt/nexxus/current/backend/.venv/bin/alembic upgrade head

 ExecStart=/opt/nexxus/current/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2

 Restart=on-failure
 RestartSec=5

 TimeoutStartSec=120
 TimeoutStopSec=30

 NoNewPrivileges=yes
 PrivateTmp=yes

 ProtectSystem=strict
 ProtectHome=yes

 ReadWritePaths=/var/lib/nexxus
 ReadWritePaths=/var/log/nexxus

 UMask=0027

 [Install]
 WantedBy=multi-user.target

diff --git a/scripts/validate-package.sh b/scripts/validate-package.sh
--- a/scripts/validate-package.sh
+++ b/scripts/validate-package.sh
@@
-#!/usr/bin/env bash
-set -Eeuo pipefail
-
-ROOT=${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
-
-# valida instalação e systemd
+#!/usr/bin/env bash
+
+set -Eeuo pipefail
+
+ROOT="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
+
+failures=0
+
+fail() {
+    echo "[FAIL] $*" >&2
+    failures=$((failures+1))
+}
+
+ok() {
+    echo "[OK] $*"
+}
+
+required=(
+    backend/pyproject.toml
+    backend/alembic.ini
+    backend/app/main.py
+    backend/migrations/env.py
+    config/api.env.example
+    scripts/install.sh
+    scripts/validate-package.sh
+    systemd/nexxus-api.service
+)
+
+for file in "${required[@]}"; do
+    if [[ -f "$ROOT/$file" ]]; then
+        ok "$file"
+    else
+        fail "Ausente: $file"
+    fi
+done
+
+echo
+echo "[INFO] Validando scripts..."
+
+while IFS= read -r script; do
+    bash -n "$script" \
+        && ok "${script#$ROOT/}" \
+        || fail "${script#$ROOT/}"
+done < <(find "$ROOT/scripts" -type f -name "*.sh" | sort)
+
+echo
+echo "[INFO] Compilando Python..."
+
+python3 -m compileall \
+    "$ROOT/backend/app" \
+    "$ROOT/backend/migrations" \
+    >/dev/null \
+    && ok "Compilação Python" \
+    || fail "Compilação Python"
+
+echo
+echo "[INFO] Validando unit files..."
+
+grep -q "^ExecStart=" \
+    "$ROOT/systemd/nexxus-api.service" \
+    && ok "nexxus-api.service" \
+    || fail "nexxus-api.service"
+
+echo
+
+if ((failures > 0)); then
+    echo "[FAIL] Falhas encontradas: $failures"
+    exit 1
+fi
+
+echo "[OK] Pacote validado com sucesso"

diff --git a/scripts/smoke-test.sh b/scripts/smoke-test.sh
--- a/scripts/smoke-test.sh
+++ b/scripts/smoke-test.sh
@@
+#!/usr/bin/env bash
+
+set -Eeuo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+
+"$ROOT/scripts/validate-package.sh"
+
+if command -v pytest >/dev/null 2>&1; then
+    pytest backend/tests -q
+else
+    echo "[WARN] pytest não instalado"
+fi
+
+echo "[OK] Smoke test concluído"

